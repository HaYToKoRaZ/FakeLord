<Window x:Class="HaYTooL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaYTooL" Height="210" Width="470"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="#11131A"
        ResizeMode="NoResize"
        Icon="app.ico"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DropShadowEffect x:Key="BadgeGlow" BlurRadius="8" ShadowDepth="0" Opacity="0.6" Color="#10B981"/>
    </Window.Resources>

    <!-- Outer Container -->
    <Border Background="#11131A" BorderBrush="#262D3D" BorderThickness="1">
        <Grid Margin="14,10,14,12">
            <Grid.RowDefinitions>
                <!-- Header Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Content Card -->
                <RowDefinition Height="*"/>
                <!-- Footer Actions -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header (Title & Controls) -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="4" Background="#1E2333" Margin="0,0,8,0">
                        <Image Source="app.ico" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="HaYTooL" FontWeight="Bold" FontSize="13" Foreground="#F3F4F6"/>
                    <TextBlock Text="• Ghost Runner" FontSize="11" Foreground="#6B7280" Margin="6,1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}" Content="—" FontSize="11" Click="BtnMinimize_Click" ToolTip="Küçült"/>
                    <Button Style="{StaticResource CloseButton}" Content="✕" FontSize="12" Click="BtnClose_Click" ToolTip="Oyunu Durdur ve Kapat"/>
                </StackPanel>
            </Grid>

            <!-- 2. Main Content Card -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Game Cover Image -->
                <Border Grid.Column="0" Width="80" Height="80" CornerRadius="10" Background="#181B26" BorderBrush="#2F364D" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <!-- Fallback Icon -->
                        <TextBlock x:Name="TxtFallbackIcon" Text="🎮" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4B5563"/>
                        <!-- Actual Image -->
                        <Image x:Name="ImgGameCover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>

                <!-- Game Info & Live Timer -->
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <!-- Status Badge & Process Name -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                        <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#10B981" Effect="{StaticResource BadgeGlow}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="OYUNDA" FontWeight="Bold" FontSize="10" Foreground="#34D399" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TxtExeName" Text="valorant.exe" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Game Title -->
                    <TextBlock x:Name="TxtGameTitle" Text="Valorant" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                    <!-- Live Duration & Stats -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏱️" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDuration" Text="00:00:00" FontFamily="Consolas, Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="•  ⚡ %0 CPU  •  RAM: 14 MB" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 3. Footer Action: Stop Game & Return to FakeLord -->
            <Grid Grid.Row="2" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Click="BtnStopGame_Click" Cursor="Hand" Height="30">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="#B91C1C" CornerRadius="7" Padding="12,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⏹️" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Oyunu Durdur &amp; FakeLord'a Dön" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#DC2626"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#991B1B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window>
