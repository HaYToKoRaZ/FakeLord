<Window x:Class="FakelordUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fakelord v1.7" 
        Icon="icon.png"
        Height="880" Width="570"
        MinWidth="570" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#1E1F22" Foreground="#F3F4F6"
        FontFamily="Segoe UI, Inter" ResizeMode="CanResizeWithGrip"
        x:Name="RootWindow">

    <Window.Resources>
        <!-- Dinamik Tema Fırçaları (Varsayılan: Discord Nitro) -->
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#5865F2"/>
        <SolidColorBrush x:Key="ThemeAccentHoverBrush" Color="#4752C4"/>
        <SolidColorBrush x:Key="ThemeTextAccentBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeWinBgBrush" Color="#1E1F22"/>
        <SolidColorBrush x:Key="ThemeCardBgBrush" Color="#2B2D31"/>
        <SolidColorBrush x:Key="ThemeInnerBgBrush" Color="#313338"/>
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#3E4249"/>

        <!-- Modern Ana Buton -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Durdur Butonu -->
        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#ED4245"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C03537"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Liste Elemanı Stili -->
        <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="8" Margin="0,1,0,3" Padding="0"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#171E2D"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#25324A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#222C42"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Stili -->
        <ControlTemplate x:Key="ThemeComboItemTemplate" TargetType="ComboBoxItem">
            <Border x:Name="itemBorder" Background="#161B26" Padding="10,6" CornerRadius="4" Margin="1">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="itemBorder" Property="Background" Value="#273042"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Grid>
                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"/>
                <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                      Fill="#94A3B8" Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#222C3F"/>
                    <Setter TargetName="border" Property="BorderBrush" Value="#3B4863"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernDarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#141A26"/>
            <Setter Property="BorderBrush" Value="#222C3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F0F6FC"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}" 
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,26,6"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"                
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#141924"
                                            BorderThickness="1"
                                            BorderBrush="#2E3A52"
                                            CornerRadius="8"
                                            Margin="0,4,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.6"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,4,4,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Buton Şablonu -->
        <Style x:Key="ModernIconButton" TargetType="Button">
            <Setter Property="Background" Value="#141A26"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderBrush" Value="#222C3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#222D40"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AboutLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#111622"/>
            <Setter Property="BorderBrush" Value="#1E2638"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1B2436"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A-Z Alfabetik Hızlı Atlama Buton Stili -->
        <Style x:Key="AlphaJumpButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E273A"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid">
        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header -->
                <RowDefinition Height="Auto"/> <!-- 1: Live Status & Launch Card -->
                <RowDefinition Height="Auto"/> <!-- 2: Favorites Bar -->
                <RowDefinition Height="Auto"/> <!-- 3: Search & Category Tabs -->
                <RowDefinition Height="*"/>    <!-- 4: Game List (Expands to fill vertical space!) -->
                <RowDefinition Height="Auto"/> <!-- 5: Footer Status Line -->
            </Grid.RowDefinitions>

            <!-- 0. ÜST BAR: Marka, Versiyon ve Kontrol Butonları -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Marka & Versiyon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Margin="0,0,8,0" ClipToBounds="True" Background="Transparent">
                        <Image Source="icon.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="FAKELORD" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border x:Name="VersionBadgeBorder" Background="#161D2B" BorderBrush="#222C3F" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="7,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="FakeLord v1.7" MouseDown="VersionBadge_MouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVersionBadge" Text="v1.7" FontSize="10.5" Foreground="#38BDF8" FontWeight="Bold"/>
                            <Ellipse x:Name="NewVersionDot" Width="6" Height="6" Fill="#10B981" Margin="4,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="WebBadgeBorder" Background="#161D2B" BorderBrush="#222C3F" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="FakeLord Web (haytokoraz.github.io/FakeLord)" MouseDown="WebBadge_MouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐 Web" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="PortalBadgeBorder" Background="#161D2B" BorderBrush="#222C3F" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="HaYTooL Portal (haytokoraz.github.io)" MouseDown="PortalBadge_MouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚀 HaYTooL" FontSize="10" Foreground="#A78BFA" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sağ Üst Araç Butonları -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="ComboTheme" Style="{StaticResource ModernDarkComboBox}"
                              Width="125" Margin="0,0,6,0"
                              FontSize="11" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center"/>

                    <!-- Discord Canlı Katalog Yenile -->
                    <Button x:Name="BtnRefreshDiscord" Content="🔄" Style="{StaticResource ModernIconButton}"
                            Padding="8,5" Margin="0,0,5,0" Click="BtnRefreshDiscord_Click"/>

                    <!-- Ayarlar -->
                    <Button x:Name="BtnSettings" Content="⚙️" Style="{StaticResource ModernIconButton}"
                            Padding="8,5" Margin="0,0,5,0" Click="BtnSettings_Click"/>

                    <!-- Hakkında -->
                    <Button x:Name="BtnAbout" Content="ℹ️" Style="{StaticResource ModernIconButton}"
                            Padding="8,5" Click="BtnAbout_Click"/>
                </StackPanel>
            </Grid>

            <!-- 1. CANLI OYUN & BAŞLATMA KARTI (Hero Dashboard) -->
            <Border Grid.Row="1" x:Name="MainCardBorder" Background="#121724" CornerRadius="12" BorderBrush="#202A3C" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Başlık -->
                    <TextBlock Grid.Row="0" x:Name="TxtLiveCardHeader" Text="Discord Profil Önizlemesi" FontSize="10.5" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,8"/>

                    <!-- Üst: Oyun Bilgisi ve Önizleme -->
                    <Border Grid.Row="1" x:Name="InnerGameCard" Background="#171E2D" CornerRadius="9" Padding="10" BorderBrush="#242F44" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Oyun Küçük Resmi (Tam sığan 42x42 badge) -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#1D2536" Margin="0,0,10,0" ClipToBounds="True" BorderBrush="#2B374E" BorderThickness="1">
                                <Grid>
                                    <TextBlock x:Name="PreviewBadgeFallback" Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                                    <Image x:Name="PreviewGameIcon" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>

                            <!-- Başlık & Exe Bilgisi -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPlayingTitle" Text="Şu Anda Oynanıyor" FontSize="9.5" FontWeight="SemiBold" Foreground="#8B949E"/>
                                <TextBlock x:Name="PreviewGameTitle" Text="Oyun Seçilmedi" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PreviewGameExe" Text="Exe: Bekleniyor..." FontSize="10.5" Foreground="#818CF8" FontFamily="Consolas" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Sağ: Durum Göstergesi -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock x:Name="PreviewStatus" Text="Oynamaya hazır" FontSize="10.5" FontWeight="Medium" Foreground="#8B949E" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="TxtSubtitle" Text="Discord Profil Simülatörü" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Alt: Başlat ve Durdur Aksiyon Butonları -->
                    <Grid Grid.Row="2" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="BtnStart" Content="▶ Discord'da Oyna" Style="{StaticResource ModernButton}" 
                                Height="36" Margin="0,0,6,0" Click="BtnStart_Click"/>
                        <Button Grid.Column="1" x:Name="BtnStop" Content="⏹ Durdur" Style="{StaticResource StopButton}" 
                                Height="36" Click="BtnStop_Click" IsEnabled="False"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. FAVORİLER ÇUBUĞU (Tek Tıklamayla Hızlı Geçiş) -->
            <Border Grid.Row="2" x:Name="FavBorder" Background="#111520" CornerRadius="9" Padding="8,5" BorderBrush="#1C2333" BorderThickness="1" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtFavLabel" Text="⭐ Favoriler:" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center" Margin="2,0,6,0"/>

                    <!-- Favoriler Yatay Buton Listesi -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FavoritesPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ScrollViewer>

                    <!-- Mevcut Oyunu Favorilere Ekle/Çıkar Butonu -->
                    <Button Grid.Column="2" x:Name="BtnToggleFav" Content="⭐ Ekle" 
                            Background="#18202F" Foreground="#F0F6FC" BorderBrush="#253046" BorderThickness="1"
                            Padding="8,3" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" Click="BtnToggleFav_Click" Margin="4,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. ARAMA VE KATEGORİ SEKMELERİ -->
            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <!-- Arama Kutusu -->
                <Border x:Name="SearchBoxBorder" Background="#131824" CornerRadius="8" Padding="9,6" BorderBrush="#222C3F" BorderThickness="1" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#64748B" FontSize="12"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" Foreground="#F0F6FC" BorderThickness="0" 
                                 FontSize="12" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" CaretBrush="#5865F2"/>
                        <Button Grid.Column="2" x:Name="BtnAddSteamApp" Content="+ Steam"
                                Background="#1A2436" Foreground="#38BDF8" BorderBrush="#2C3A54" BorderThickness="1"
                                Padding="6,2" FontSize="10" FontWeight="SemiBold" Cursor="Hand" Click="BtnAddSteamApp_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Kategori Butonları (Pill Segmented Control) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnTabAll" Content="🎮 Tümü" Background="#5865F2" Foreground="#FFFFFF"
                            BorderThickness="0" Padding="0,5" Margin="0,0,3,0" FontSize="10.5" FontWeight="SemiBold"
                            Cursor="Hand" Click="BtnTabAll_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="1" x:Name="BtnTabSteamTop" Content="🔥 Top 100" Background="#141A26" Foreground="#94A3B8"
                            BorderThickness="0" Padding="0,5" Margin="2,0,3,0" FontSize="10.5" FontWeight="SemiBold"
                            Cursor="Hand" Click="BtnTabSteamTop_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" x:Name="BtnTabSteamInstalled" Content="💻 Yüklü" Background="#141A26" Foreground="#94A3B8"
                            BorderThickness="0" Padding="0,5" Margin="2,0,0,0" FontSize="10.5" FontWeight="SemiBold"
                            Cursor="Hand" Click="BtnTabSteamInstalled_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Alfabetik Hızlı Atlama Şeridi (A-Z Quick Jump Bar) -->
                <Border x:Name="AlphaJumpBorder" Background="#0F131E" CornerRadius="7" BorderBrush="#1C2436" BorderThickness="1" Margin="0,5,0,0" Padding="2,2">
                    <UniformGrid x:Name="AlphaJumpGrid" Rows="1" Columns="27" HorizontalAlignment="Stretch"/>
                </Border>
            </StackPanel>

            <!-- 4. AKTİF OYUNLAR LİSTESİ (Tüm dikey boşluğu doldurur) -->
            <Border Grid.Row="4" x:Name="GameListBorder" Background="#121724" CornerRadius="10" BorderBrush="#202A3C" BorderThickness="1" Padding="4" Margin="0,0,0,8">
                <ListBox x:Name="GamesVisibleList" Background="Transparent" BorderThickness="0" Foreground="White"
                         ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                         SelectionChanged="GamesVisibleList_SelectionChanged"
                         MouseDoubleClick="GamesVisibleList_MouseDoubleClick"
                         IsTextSearchEnabled="True"
                         TextSearch.TextPath="Title"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" CornerRadius="7" Background="#151C2A" BorderBrush="#1E273A" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Mini Kare Simge (28x28 - Kırpılmadan tam sığar) -->
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#1D2536" Margin="0,0,9,0" ClipToBounds="True" BorderBrush="#2B374E" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="🎮" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35"/>
                                            <Image Source="{Binding ImageUrl}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>

                                    <!-- Oyun Başlığı ve Exe -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayExeName}" FontSize="10" Foreground="#818CF8" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Rozetler -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#162238" CornerRadius="4" Padding="5,2" Margin="0,0,4,0" Visibility="{Binding SteamBadgeVisibility}">
                                            <TextBlock Text="{Binding SteamAppId, StringFormat='Steam: {0}'}" FontSize="9" Foreground="#38BDF8" FontFamily="Consolas"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 5. ALT DURUM ÇUBUĞU (Footer) -->
            <Border Grid.Row="5" x:Name="FooterBorder" Background="#0F131D" CornerRadius="8" Padding="10,5" BorderBrush="#1C2333" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusMessage" Text="● Hazır. Listeden veya favorilerden oyun seçin." FontSize="10.5" Foreground="#10B981" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="1" Background="#161E2E" CornerRadius="6" Padding="6,2" Margin="6,0,0,0">
                        <TextBlock x:Name="GameCountBadge" Text="9 Oyun" FontSize="10" Foreground="#5865F2" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- HAKKINDA (ABOUT) MODAL OVERLAY -->
        <Grid x:Name="AboutModalOverlay" Visibility="Collapsed" Background="#CC05070A" Panel.ZIndex="1000"
              MouseDown="AboutModalOverlay_MouseDown">
            <Border x:Name="AboutCardBorder" Width="400" Background="#0F141F" CornerRadius="14" BorderBrush="#252F44" BorderThickness="1"
                    Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MouseDown="AboutCard_MouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0" ClipToBounds="True" Background="#161B26">
                                <Image Source="icon.png" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="FAKELORD" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Border Background="#1E293B" CornerRadius="6" Padding="5,2" Margin="6,0,0,0">
                                        <TextBlock Text="v1.7" FontSize="10" Foreground="#38BDF8" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TxtAboutDeveloper" Text="Geliştirici: HaYTo" FontSize="11" Foreground="#A0AEC0" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Content="✕" Width="26" Height="26" Background="#1A202C" Foreground="#94A3B8"
                                BorderThickness="0" Cursor="Hand" Click="BtnCloseAbout_Click" FontSize="12" FontWeight="Bold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Description -->
                    <Border Grid.Row="1" Background="#141924" CornerRadius="8" Padding="10,8" Margin="0,0,0,12" BorderBrush="#202838" BorderThickness="1">
                        <TextBlock x:Name="TxtAboutDesc" 
                                   Text="Projeyi geliştirmeme katkıda bulunmak ve güncellemelerden haberdar olmak için bağlantıları kullanabilirsiniz:"
                                   FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="16"/>
                    </Border>

                    <!-- Links List -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <Button Margin="0,0,0,6" Style="{StaticResource AboutLinkButtonStyle}" Click="LinkWebsite_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🌐" FontSize="14" Foreground="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtWebsiteTitle" Text="Resmi Web Sitesi • FakeLord" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtWebsiteDesc" Text="haytokoraz.github.io/FakeLord • Bilgi &amp; İndirme" FontSize="10" Foreground="#8B949E"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="↗" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Margin="0,0,0,6" Style="{StaticResource AboutLinkButtonStyle}" Click="LinkPortal_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🚀" FontSize="14" Foreground="#A78BFA" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPortalTitle" Text="HaYTooL Portal • Ekosistem" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtPortalDesc" Text="haytokoraz.github.io • Geliştirici Portalı" FontSize="10" Foreground="#8B949E"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="↗" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Margin="0,0,0,6" Style="{StaticResource AboutLinkButtonStyle}" Click="LinkGithub_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🐙" FontSize="14" Foreground="#FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtGithubTitle" Text="GitHub • HaYToKoRaZ/FakeLord" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtGithubDesc" Text="Kaynak Kod &amp; ⭐ Yıldız Ver" FontSize="10" Foreground="#8B949E"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="↗" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Margin="0,0,0,6" Style="{StaticResource AboutLinkButtonStyle}" Click="LinkIssues_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🐞" FontSize="14" Foreground="#FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtIssuesTitle" Text="GitHub Issues • Hata &amp; İstek" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtIssuesDesc" Text="Geri Bildirim &amp; Hata Bildirimi" FontSize="10" Foreground="#8B949E"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="↗" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource AboutLinkButtonStyle}" Click="LinkEmail_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="✉️" FontSize="14" Foreground="#FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtEmailTitle" Text="E-posta • korazhayto@gmail.com" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtEmailDesc" Text="Öneri &amp; Doğrudan İletişim" FontSize="10" Foreground="#8B949E"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="↗" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Footer Close Button -->
                    <Button Grid.Row="3" x:Name="BtnAboutClose" Content="Kapat" Background="#242C3D" Foreground="#FFFFFF"
                            BorderThickness="0" Height="34" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Click="BtnCloseAbout_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- AYARLAR (SETTINGS) MODAL OVERLAY -->
        <Grid x:Name="SettingsModalOverlay" Visibility="Collapsed" Background="#CC05070A" Panel.ZIndex="1000"
              MouseDown="SettingsModalOverlay_MouseDown">
            <Border x:Name="SettingsCardBorder" Width="400" MaxHeight="640" Background="#0F141F" CornerRadius="14" BorderBrush="#252F44" BorderThickness="1"
                    Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MouseDown="SettingsCard_MouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSettingsHeaderTitle" Text="⚙️ Tercihler &amp; Ayarlar" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtSettingsHeaderDesc" Text="Uygulama davranışını ve temasını özelleştirin" FontSize="11" Foreground="#8B949E" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Width="26" Height="26" Background="#1A202C" Foreground="#94A3B8"
                                BorderThickness="0" Cursor="Hand" Click="BtnCloseSettings_Click" FontSize="12" FontWeight="Bold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Options (Scrollable) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Dil Seçimi Kartı -->
                            <Border Background="#141924" CornerRadius="9" Padding="12,10" Margin="0,0,0,8" BorderBrush="#202838" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSettingsLangTitle" Text="🌐 Arayüz Dili" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtSettingsLangDesc" Text="Dil seçin (Türkçe / English)" FontSize="10.5" Foreground="#8B949E" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="ComboSettingsLang" Style="{StaticResource ModernDarkComboBox}"
                                              Width="140" FontSize="11" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Tema Seçimi Kartı -->
                            <Border Background="#141924" CornerRadius="9" Padding="12,10" Margin="0,0,0,8" BorderBrush="#202838" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSettingsThemeTitle" Text="🎨 Renk Teması" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtSettingsThemeDesc" Text="Arayüz renk paleti" FontSize="10.5" Foreground="#8B949E" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="ComboSettingsTheme" Style="{StaticResource ModernDarkComboBox}"
                                              Width="140" FontSize="11" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center"
                                              SelectionChanged="ComboSettingsTheme_SelectionChanged"/>
                                </Grid>
                            </Border>

                            <!-- Açılışta Discord Kataloğunu Otomatik Güncelle -->
                            <Border Background="#141924" CornerRadius="9" Padding="12,9" Margin="0,0,0,8" BorderBrush="#202838" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSettingsAutoFetchTitle" Text="🔄 Discord Kataloğunu Otomatik Güncelle" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtSettingsAutoFetchDesc" Text="Açılışta 4000+ oyunluk listeyi arka planda tazeler" FontSize="10.5" Foreground="#8B949E" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkAutoFetchDiscord" IsChecked="True" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Sistem Tepsisi (Tray) Etkinleştir -->
                            <Border Background="#141924" CornerRadius="9" Padding="12,9" Margin="0,0,0,8" BorderBrush="#202838" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSettingsTrayTitle" Text="🔔 Sistem Tepsisi (System Tray) Simgesi" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtSettingsTrayDesc" Text="Saatin yanında uygulama simgesi gösterir" FontSize="10.5" Foreground="#8B949E" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkEnableTray" IsChecked="True" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Tepsiye Küçült -->
                            <Border Background="#141924" CornerRadius="9" Padding="12,9" Margin="0,0,0,8" BorderBrush="#202838" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSettingsMinToTrayTitle" Text="🔽 Kapatıldığında Tepsiye Küçült" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtSettingsMinToTrayDesc" Text="Kapatıldığında arka planda çalışmaya devam eder" FontSize="10.5" Foreground="#8B949E" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkMinimizeToTray" IsChecked="True" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Windows ile Birlikte Başlat -->
                            <Border Background="#141924" CornerRadius="9" Padding="12,9" Margin="0,0,0,8" BorderBrush="#202838" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSettingsStartupTitle" Text="🚀 Windows ile Birlikte Başlat" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtSettingsStartupDesc" Text="Bilgisayar açıldığında FakeLord başlasın" FontSize="10.5" Foreground="#8B949E" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkStartWithWindows" IsChecked="False" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Açılışta Küçültülmüş Başlat -->
                            <Border Background="#141924" CornerRadius="9" Padding="12,9" Margin="0,0,0,8" BorderBrush="#202838" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSettingsStartMinTitle" Text="🔕 Açılışta Tepsiye Gizlenmiş Başlat" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtSettingsStartMinDesc" Text="Açılışta pencere ekrana gelmez, sessizce tepside bekler" FontSize="10.5" Foreground="#8B949E" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkStartMinimized" IsChecked="False" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Web Sitesi Kartı -->
                            <Border Background="#141924" CornerRadius="9" Padding="12,9" BorderBrush="#202838" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSettingsWebTitle" Text="🌐 Resmi Web Sitesi" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtSettingsWebDesc" Text="haytool.online/FakeLord" FontSize="10.5" Foreground="#8B949E" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Ziyaret Et ↗" Background="#1D2638" Foreground="#38BDF8" BorderBrush="#2F3E5C" BorderThickness="1"
                                            Padding="10,4" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand" Click="LinkWebsite_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Actions -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Margin="0,0,8,0" x:Name="BtnSettingsCancel" Content="İptal" Background="#202738" Foreground="#94A3B8"
                                BorderThickness="0" Height="34" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                Click="BtnCloseSettings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="1" Width="160" x:Name="BtnSettingsSave" Content="💾 Kaydet &amp; Uygula" Background="#5865F2" Foreground="#FFFFFF"
                                BorderThickness="0" Height="34" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                Click="BtnSaveSettings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Toast Bildirimi -->
        <Border x:Name="ToastBorder" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                Background="#161E2E" BorderBrush="#38BDF8" BorderThickness="1.2" CornerRadius="18"
                Padding="14,7" Visibility="Collapsed" Opacity="0" Panel.ZIndex="999" Cursor="Hand"
                MouseDown="ToastBorder_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtToastIcon" Text="🔄" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtToastMessage" Text="Tüm kaynaklar güncelleniyor..." FontSize="11.5" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtToastAction" Text="↗" FontSize="11.5" Foreground="#38BDF8" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
