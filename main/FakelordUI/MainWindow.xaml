<Window x:Class="FakelordUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fakelord" 
        Icon="icon.png"
        Height="670" Width="740"
        WindowStartupLocation="CenterScreen"
        Background="#0A0C10" Foreground="#F3F4F6"
        FontFamily="Segoe UI, Inter" ResizeMode="CanMinimize"
        x:Name="RootWindow">

    <Window.Resources>
        <!-- Modern Ana Buton -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4752C4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Durdur Butonu -->
        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#ED4245"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C03537"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Liste Elemanı Stili -->
        <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#252B3B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2D354A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Stili -->
        <ControlTemplate x:Key="ThemeComboItemTemplate" TargetType="ComboBoxItem">
            <Border x:Name="itemBorder" Background="#161B26" Padding="10,6" CornerRadius="4" Margin="1">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="itemBorder" Property="Background" Value="#273042"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="itemBorder" Property="Background" Value="#5865F2"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern Hakkında Link Kart Butonu Stili -->
        <Style x:Key="AboutLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#111622"/>
            <Setter Property="BorderBrush" Value="#1E2638"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1B2436"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header & Controls -->
                <RowDefinition Height="Auto"/> <!-- 1: Favorites Bar -->
                <RowDefinition Height="Auto"/> <!-- 2: Steam Kütüphane / Filtre Sekmeleri -->
                <RowDefinition Height="Auto"/> <!-- 3: Search Bar -->
                <RowDefinition Height="150"/>  <!-- 4: Canlı Oyun Tablosu / Listesi -->
                <RowDefinition Height="Auto"/> <!-- 5: Live Discord Card & Controls -->
                <RowDefinition Height="Auto"/> <!-- 6: Footer -->
            </Grid.RowDefinitions>

            <!-- 0. Üst Bar: Logo, Dil Seçimi & Tema Seçimi -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo ve Başlık -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,8,0" ClipToBounds="True" Background="Transparent">
                            <Image Source="icon.png" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="FAKELORD" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border x:Name="VersionBadgeBorder" Background="#1C2130" BorderBrush="#252C3D" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="FakeLord v1.2" MouseDown="VersionBadge_MouseDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtVersionBadge" Text="v1.2" FontSize="11" Foreground="#38BDF8" FontWeight="Bold"/>
                                <Ellipse x:Name="NewVersionDot" Width="6" Height="6" Fill="#10B981" Margin="5,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1C2130" CornerRadius="10" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="GameCountBadge" Text="9 Oyun" FontSize="11" Foreground="#5865F2" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubtitle" Text="Discord Akıllı Oyun Algılama &amp; Profil Simülatörü" FontSize="11" Foreground="#8B949E" Margin="36,2,0,0"/>
                </StackPanel>

                <!-- Dil & Tema Butonları -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Dil Seçici (Gerçek Bayrak Görselli Butonlar) -->
                    <Border Background="#121620" CornerRadius="8" Padding="3" BorderBrush="#252B38" BorderThickness="1" Margin="0,0,8,0" x:Name="LangBorder">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnLangTR" Background="#2D3748" BorderThickness="0"
                                    Padding="8,4" Cursor="Hand" Click="BtnLangTR_Click" Margin="0,0,2,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="18" Height="13" CornerRadius="2" ClipToBounds="True" Margin="0,0,5,0">
                                                    <Image Source="flag_tr.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="TR" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnLangEN" Background="Transparent" BorderThickness="0"
                                    Padding="8,4" Cursor="Hand" Click="BtnLangEN_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="18" Height="13" CornerRadius="2" ClipToBounds="True" Margin="0,0,5,0">
                                                    <Image Source="flag_gb.png" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="EN" Foreground="#8B949E" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Tema Seçici Açılır Kutu -->
                    <Border x:Name="ThemeBorder" Background="#161B26" CornerRadius="8" BorderBrush="#2E374A" BorderThickness="1" Margin="0,0,8,0">
                        <ComboBox x:Name="ComboTheme"
                                  Background="Transparent" Foreground="#F0F6FC" BorderThickness="0"
                                  Padding="8,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Discord Katalog Güncelle -->
                    <Button x:Name="BtnRefreshDiscord" Content="🔄" ToolTip="Discord Kataloğunu Güncelle"
                            Background="#161B22" Foreground="#C9D1D9" BorderBrush="#30363D" BorderThickness="1" 
                            Padding="10,6" FontSize="12" FontWeight="Medium" Cursor="Hand" Click="BtnRefreshDiscord_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Hakkında Butonu -->
                    <Button x:Name="BtnAbout" Content="ℹ️" ToolTip="Hakkında &amp; İletişim"
                            Background="#161B22" Foreground="#C9D1D9" BorderBrush="#30363D" BorderThickness="1" 
                            Padding="10,6" FontSize="12" FontWeight="Medium" Cursor="Hand" Click="BtnAbout_Click" Margin="6,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

        <!-- 1. FAVORİLER ÇUBUĞU (Hızlı Geçiş & Yönetim) -->
        <Border Grid.Row="1" x:Name="FavBorder" Background="#10141D" CornerRadius="10" Padding="10,6" BorderBrush="#1C2130" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtFavLabel" Text="⭐ Favoriler:" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center" Margin="2,0,8,0"/>

                <!-- Favoriler Yatay Buton Listesi -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FavoritesPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                </ScrollViewer>

                <!-- Mevcut Oyunu Favorilere Ekle/Çıkar Butonu -->
                <Button Grid.Column="2" x:Name="BtnToggleFav" Content="⭐ Ekle" 
                        Background="#1C2230" Foreground="#F0F6FC" BorderBrush="#2D3548" BorderThickness="1"
                        Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="BtnToggleFav_Click" Margin="6,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- 2. STEAM & DİSCORD KÜTÜPHANE SEKMELERİ -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Sekme Butonları -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="BtnTabPopular" Content="⚡ Popüler &amp; Rekabetçi" Background="#5865F2" Foreground="#FFFFFF"
                        BorderThickness="0" Padding="10,5" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"
                        Cursor="Hand" Click="BtnTabPopular_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnTabAll" Content="🎮 Tüm Oyunlar" Background="#161B26" Foreground="#949BA4"
                        BorderThickness="0" Padding="10,5" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"
                        Cursor="Hand" Click="BtnTabAll_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnTabSteamTop" Content="🔥 Steam Top 100" Background="#161B26" Foreground="#949BA4"
                        BorderThickness="0" Padding="10,5" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"
                        Cursor="Hand" Click="BtnTabSteamTop_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnTabSteamInstalled" Content="💻 Yüklü Steam Oyunları" Background="#161B26" Foreground="#949BA4"
                        BorderThickness="0" Padding="10,5" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"
                        Cursor="Hand" Click="BtnTabSteamInstalled_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Steam AppID ile Özel Ekleme Butonu -->
            <Button Grid.Column="1" x:Name="BtnAddSteamApp" Content="+ Steam Oyunu Ekle"
                    Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1"
                    Padding="10,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="BtnAddSteamApp_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 3. Akıllı Arama Çubuğu -->
        <Grid Grid.Row="3" Margin="0,0,0,8" x:Name="SearchContainer">
            <Border x:Name="SearchBoxBorder" Background="#121620" CornerRadius="8" Padding="10,7" BorderBrush="#252C3D" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#6E7681" FontSize="13"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" Foreground="#F0F6FC" BorderThickness="0" 
                             FontSize="12" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" CaretBrush="#5865F2"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Aktif Oyunlar Listesi (Görünür Liste - Tıklayarak Seçim) -->
        <Border Grid.Row="4" x:Name="GameListBorder" Background="#121620" CornerRadius="8" BorderBrush="#252C3D" BorderThickness="1" Padding="4" Margin="0,0,0,10">
            <ListBox x:Name="GamesVisibleList" Background="Transparent" BorderThickness="0" Foreground="White"
                     ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                     SelectionChanged="GamesVisibleList_SelectionChanged"
                     MouseDoubleClick="GamesVisibleList_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,4" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Mini Simge / Görsel -->
                                <Border Grid.Column="0" Width="36" Height="22" CornerRadius="4" Background="#1A202C" Margin="0,0,10,0" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="🎮" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
                                    </Grid>
                                </Border>

                                <!-- Oyun Başlığı -->
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                
                                <!-- Rozetler -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#162238" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding SteamBadgeVisibility}">
                                        <TextBlock Text="{Binding SteamAppId, StringFormat='Steam: {0}'}" FontSize="9" Foreground="#38BDF8" FontFamily="Consolas"/>
                                    </Border>
                                    <Border Background="#1C2130" CornerRadius="4" Padding="6,2" ToolTip="{Binding ExeName}">
                                        <TextBlock Text="{Binding DisplayExeName}" FontSize="10" Foreground="#818CF8" FontFamily="Consolas"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 5. Discord Kartı & Kontroller -->
        <Border Grid.Row="5" x:Name="MainCardBorder" Background="#121620" CornerRadius="12" BorderBrush="#252C3D" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TxtLiveCardHeader" Text="Discord Profil Önizlemesi" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,10"/>

                <!-- Discord Oynuyor Kartı -->
                <Border Grid.Row="1" x:Name="InnerGameCard" Background="#181C26" CornerRadius="10" Padding="12" BorderBrush="#252B38" BorderThickness="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Oyun Afişi / Kapak Resmi -->
                        <Border Grid.Column="0" Width="130" Height="65" CornerRadius="8" Background="#1F2433" Margin="0,0,16,0" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="PreviewBadgeFallback" Text="🎮" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                <Image x:Name="PreviewGameIcon" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <!-- Başlık ve Durum -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPlayingTitle" Text="Şu Anda Oynanıyor" FontSize="10" FontWeight="SemiBold" Foreground="#949BA4" Margin="0,0,0,2"/>
                            <TextBlock x:Name="PreviewGameTitle" Text="Oyun Seçilmedi" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PreviewGameExe" Text="Exe: Bekleniyor..." FontSize="11" Foreground="#5865F2" FontFamily="Consolas" Margin="0,2,0,0"/>
                            <TextBlock x:Name="PreviewStatus" Text="Oynamaya hazır" FontSize="11" Foreground="#8B949E" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Başlat / Durdur Butonları -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnStart" Content="▶ Discord'da Oyna" Style="{StaticResource ModernButton}" 
                            Height="38" Margin="0,0,6,0" Click="BtnStart_Click"/>
                    <Button Grid.Column="1" x:Name="BtnStop" Content="⏹ Oyunu Durdur" Style="{StaticResource StopButton}" 
                            Height="38" Margin="6,0,0,0" Click="BtnStop_Click" IsEnabled="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 6. Alt Bilgi & Bildirim Çubuğu -->
        <Border Grid.Row="6" x:Name="FooterBorder" Margin="0,10,0,0" Background="#0D0F15" CornerRadius="8" Padding="12,6" BorderBrush="#1C2130" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="StatusMessage" Text="● Hazır. Listeden veya arama kutusundan bir oyun seçin." FontSize="11" Foreground="#10B981"/>
                <TextBlock Text="FakeLord v1.1 • Discord Game Simulator" HorizontalAlignment="Right" FontSize="10" Foreground="#6E7681"/>
            </Grid>
        </Border>
    </Grid>

    <!-- 7. HAKKINDA (ABOUT) MODAL OVERLAY -->
    <Grid x:Name="AboutModalOverlay" Visibility="Collapsed" Background="#CC05070A" Panel.ZIndex="1000"
          MouseDown="AboutModalOverlay_MouseDown">
        <Border x:Name="AboutCardBorder" Width="510" Background="#0F141F" CornerRadius="16" BorderBrush="#252F44" BorderThickness="1"
                Padding="22" VerticalAlignment="Center" HorizontalAlignment="Center"
                MouseDown="AboutCard_MouseDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Header -->
                    <RowDefinition Height="Auto"/> <!-- 1: Description -->
                    <RowDefinition Height="Auto"/> <!-- 2: Links List -->
                    <RowDefinition Height="Auto"/> <!-- 3: Footer Close -->
                </Grid.RowDefinitions>

                <!-- 0: Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" ClipToBounds="True" Background="#161B26">
                            <Image Source="icon.png" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="FAKELORD" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <Border Background="#1E293B" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="v1.2" FontSize="11" Foreground="#38BDF8" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtAboutDeveloper" Text="Geliştirici: HaYTo" FontSize="12" Foreground="#A0AEC0" Margin="0,2,0,0" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close (X) Button -->
                    <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="#1A202C" Foreground="#94A3B8"
                            BorderThickness="0" Cursor="Hand" Click="BtnCloseAbout_Click" FontSize="13" FontWeight="Bold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 1: Description -->
                <Border Grid.Row="1" Background="#141924" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" BorderBrush="#202838" BorderThickness="1">
                    <TextBlock x:Name="TxtAboutDesc" 
                               Text="Projeyi geliştirmeme katkıda bulunmak, güncellemelerden haberdar olmak veya geri bildirim bırakmak için bağlantıları kullanabilirsiniz:"
                               FontSize="11.5" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="17"/>
                </Border>

                <!-- 2: Clickable Links List -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <!-- X (Twitter) -->
                    <Button Margin="0,0,0,7" Style="{StaticResource AboutLinkButtonStyle}" Click="LinkTwitter_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="𝕏" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTwitterTitle" Text="X (Twitter) • @HaYTo" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtTwitterDesc" Text="Güncellemeler &amp; Duyurular" FontSize="10.5" Foreground="#8B949E"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="↗" FontSize="13" Foreground="#8B949E" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- GitHub -->
                    <Button Margin="0,0,0,7" Style="{StaticResource AboutLinkButtonStyle}" Click="LinkGithub_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🐙" FontSize="15" Foreground="#FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtGithubTitle" Text="GitHub • HaYToKoRaZ/FakeLord" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtGithubDesc" Text="Kaynak Kod &amp; ⭐ Yıldız Ver" FontSize="10.5" Foreground="#8B949E"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="↗" FontSize="13" Foreground="#8B949E" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- GitHub Issues -->
                    <Button Margin="0,0,0,7" Style="{StaticResource AboutLinkButtonStyle}" Click="LinkIssues_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🐞" FontSize="15" Foreground="#FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtIssuesTitle" Text="GitHub Issues • Hata &amp; İstek" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtIssuesDesc" Text="Geri Bildirim &amp; Hata Bildirimi" FontSize="10.5" Foreground="#8B949E"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="↗" FontSize="13" Foreground="#8B949E" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Email -->
                    <Button Style="{StaticResource AboutLinkButtonStyle}" Click="LinkEmail_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="✉️" FontSize="15" Foreground="#FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtEmailTitle" Text="E-posta • korazhayto@gmail.com" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtEmailDesc" Text="Öneri &amp; Doğrudan İletişim" FontSize="10.5" Foreground="#8B949E"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="↗" FontSize="13" Foreground="#8B949E" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- 3: Footer Close Button -->
                <Button Grid.Row="3" x:Name="BtnAboutClose" Content="Kapat" Background="#242C3D" Foreground="#FFFFFF"
                        BorderThickness="0" Height="36" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnCloseAbout_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>

    <!-- Toast Notification (Floating Pill at top-center) -->
    <Border x:Name="ToastBorder" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
            Background="#161E2E" BorderBrush="#38BDF8" BorderThickness="1.2" CornerRadius="18"
            Padding="16,8" Visibility="Collapsed" Opacity="0" Panel.ZIndex="999" Cursor="Hand"
            MouseDown="ToastBorder_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="TxtToastIcon" Text="🔄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtToastMessage" Text="Tüm kaynaklar güncelleniyor..." FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtToastAction" Text="↗" FontSize="12" Foreground="#38BDF8" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Grid>
</Window>
